# CampusPulse Environment Variables

# App & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security & PII Protection
STUDENT_ID_SALT=CHANGEME_IN_PROD_SECRET_SALT_2026

# Database configuration (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://campuspulse:campuspulse_secret@localhost:5432/campuspulse_db
ASSISTANT_DATABASE_URL=postgresql+asyncpg://assistant_ro:assistant_ro_secret@localhost:5432/campuspulse_db

# API Service
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
